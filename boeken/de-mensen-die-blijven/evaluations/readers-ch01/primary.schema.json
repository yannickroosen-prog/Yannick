{
  "type": "object",
  "properties": {
    "reader": {
      "type": "string",
      "enum": [
        "Lena"
      ]
    },
    "turn_page": {
      "type": "string",
      "enum": [
        "no",
        "unsure",
        "yes"
      ]
    },
    "stopped_at": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "passage_id": {
              "$ref": "#/$defs/passageId"
            }
          },
          "required": [
            "passage_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "why_stopped": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "remember_tomorrow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {
            "$ref": "#/$defs/passageId"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "passage_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "confused_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {
            "$ref": "#/$defs/passageId"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "passage_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flag": {
            "type": "string",
            "enum": [
              "cliche",
              "confusing",
              "continuity_doubt",
              "emotion_missed",
              "exposition_dump",
              "flat_voice",
              "machine_prose",
              "no_stakes",
              "over_explained",
              "predictable",
              "slow_start",
              "stiff_dialogue"
            ]
          },
          "passage_id": {
            "$ref": "#/$defs/passageId"
          }
        },
        "required": [
          "flag",
          "passage_id"
        ],
        "additionalProperties": false
      }
    },
    "strongest_passage": {
      "type": "object",
      "properties": {
        "passage_id": {
          "$ref": "#/$defs/passageId"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "weakest_passage": {
      "type": "object",
      "properties": {
        "passage_id": {
          "$ref": "#/$defs/passageId"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "machine_tells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tell": {
            "type": "string"
          },
          "passage_id": {
            "$ref": "#/$defs/passageId"
          }
        },
        "required": [
          "tell",
          "passage_id"
        ],
        "additionalProperties": false
      }
    },
    "felt": {
      "type": "object",
      "properties": {
        "emotion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A short emotion label such as tension and relief, at most 120 characters. Put explanations in felt.reason; do not copy story prose here."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "emotion",
        "reason"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "low",
        "medium"
      ]
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "catalog_sha256": {
      "type": "string",
      "enum": [
        "b2add41a77d6ca0252e3872892b47786f9a7bff6c5097929dcb0c171f2ad861e"
      ]
    }
  },
