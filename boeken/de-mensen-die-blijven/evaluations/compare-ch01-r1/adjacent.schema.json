{
  "type": "object",
  "properties": {
    "reader": {
      "type": "string",
      "enum": [
        "Priya"
      ]
    },
    "turn_page": {
      "type": "string",
      "enum": [
        "no",
        "unsure",
        "yes"
      ]
    },
    "stopped_at": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "passage_id": {
              "$ref": "#/$defs/passageId"
            }
          },
          "required": [
            "passage_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "why_stopped": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "remember_tomorrow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {
            "$ref": "#/$defs/passageId"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "passage_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "confused_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {
            "$ref": "#/$defs/passageId"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "passage_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flag": {
            "type": "string",
            "enum": [
              "cliche",
              "confusing",
              "continuity_doubt",
              "emotion_missed",
              "exposition_dump",
              "flat_voice",
              "machine_prose",
              "no_stakes",
              "over_explained",
              "predictable",
              "slow_start",
              "stiff_dialogue"
            ]
          },
          "passage_id": {
            "$ref": "#/$defs/passageId"
          }
        },
        "required": [
          "flag",
          "passage_id"
        ],
        "additionalProperties": false
      }
    },
    "strongest_passage": {
      "type": "object",
      "properties": {
        "passage_id": {
          "$ref": "#/$defs/passageId"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "weakest_passage": {
      "type": "object",
      "properties": {
        "passage_id": {
          "$ref": "#/$defs/passageId"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "machine_tells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tell": {
            "type": "string"
          },
          "passage_id": {
            "$ref": "#/$defs/passageId"
          }
        },
        "required": [
          "tell",
          "passage_id"
        ],
        "additionalProperties": false
      }
    },
    "felt": {
      "type": "object",
      "properties": {
        "emotion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A short emotion label such as tension and relief, at most 120 characters. Put explanations in felt.reason; do not copy story prose here."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "emotion",
        "reason"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "low",
        "medium"
      ]
    },
    "compare": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "same"
      ]
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "catalog_sha256": {
      "type": "string",
      "enum": [
        "86c62eeec6b2f48209d6d22e9b7c9e7a44173e48bd94896639579843c3a41d07"
      ]
    }
  },
  "required": [
    "reader",
    "turn_page",
    "stopped_at",
    "why_stopped",
    "remember_tomorrow",
    "confused_by",
    "flags",
    "strongest_passage",
    "weakest_passage",
    "machine_tells",
    "felt",
    "confidence",
    "compare",
    "schema_version",
    "catalog_sha256"
