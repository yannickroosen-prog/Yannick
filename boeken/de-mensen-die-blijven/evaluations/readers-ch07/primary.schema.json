        "required": [
          "passage_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flag": {
            "type": "string",
            "enum": [
              "cliche",
              "confusing",
              "continuity_doubt",
              "emotion_missed",
              "exposition_dump",
              "flat_voice",
              "machine_prose",
              "no_stakes",
              "over_explained",
              "predictable",
              "slow_start",
              "stiff_dialogue"
            ]
          },
          "passage_id": {
            "$ref": "#/$defs/passageId"
          }
        },
        "required": [
          "flag",
          "passage_id"
        ],
        "additionalProperties": false
      }
    },
    "strongest_passage": {
      "type": "object",
      "properties": {
        "passage_id": {
          "$ref": "#/$defs/passageId"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "weakest_passage": {
      "type": "object",
      "properties": {
        "passage_id": {
          "$ref": "#/$defs/passageId"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "machine_tells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tell": {
            "type": "string"
          },
          "passage_id": {
            "$ref": "#/$defs/passageId"
          }
        },
        "required": [
          "tell",
          "passage_id"
        ],
        "additionalProperties": false
      }
    },
    "felt": {
      "type": "object",
      "properties": {
        "emotion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A short emotion label such as tension and relief, at most 120 characters. Put explanations in felt.reason; do not copy story prose here."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "emotion",
        "reason"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "low",
        "medium"
      ]
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "catalog_sha256": {
      "type": "string",
      "enum": [
        "fe2aaa36c14000edc8edd66ee13a0afe65db655d954ae5262b2168eaf244a00f"
      ]
    }
