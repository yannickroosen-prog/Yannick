{
  "type": "object",
  "properties": {
    "reader": {
      "type": "string",
      "enum": [
        "Lena"
      ]
    },
    "turn_page": {
      "type": "string",
      "enum": [
        "no",
        "unsure",
        "yes"
      ]
    },
    "stopped_at": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
