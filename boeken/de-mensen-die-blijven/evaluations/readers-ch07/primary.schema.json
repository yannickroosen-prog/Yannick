              "$ref": "#/$defs/passageId"
            }
          },
          "required": [
            "passage_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "why_stopped": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "remember_tomorrow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {
            "$ref": "#/$defs/passageId"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "passage_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "confused_by": {
