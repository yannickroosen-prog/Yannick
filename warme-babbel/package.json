{
  "name": "warme-babbel-app",
  "version": "0.1.0",
  "private": true,
  "description": "Warme Babbel – zelfstandige webapplicatie (Next.js + Supabase) voor Similes vzw",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:e2e": "playwright test",
    "db:local:start": "bash scripts/local-postgres.sh start",
    "db:local:stop": "bash scripts/local-postgres.sh stop",
    "db:local:reset": "bash scripts/local-postgres.sh reset",
    "migrate:local": "tsx scripts/apply-migrations.ts",
    "migration:export": "tsx scripts/wp-export-analyze.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.0.0",
    "standardwebhooks": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "pg": "^8.16.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
