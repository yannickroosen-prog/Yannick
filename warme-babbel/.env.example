# Kopieer naar .env.local voor lokale ontwikkeling. NOOIT committen met echte waarden.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side; nooit met NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Secret van de "Send Email" Auth Hook (Authentication > Hooks), formaat: v1,whsec_...
SUPABASE_AUTH_HOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
# Geverifieerd afzenderadres/domein in Resend, bv. "Warme Babbel <noreply@warmebabbel.be>"
EMAIL_FROM=
# Optioneel: adres dat meldingen over nieuwe rapporteringen ontvangt.
ADMIN_NOTIFY_EMAIL=

# --- App ---
# Publieke basis-URL van de app (voor links in e-mails). Zonder trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bestaande WordPress-site voor inhoudelijke links (Hoe?, Tips, Help, Privacybeleid).
NEXT_PUBLIC_LEGACY_SITE_URL=https://warmebabbel.be
# Extra domeinen die de app in een iframe mogen tonen (spatie-gescheiden, optioneel).
FRAME_ANCESTORS=

# --- Tests ---
# Lokale Postgres voor RLS-tests (scripts/local-postgres.sh). Standaardwaarde werkt met dat script.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/warme_babbel_test
# E2E (Playwright) tegen een echt Supabase-project + draaiende app.
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
